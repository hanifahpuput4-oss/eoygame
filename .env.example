# Turso (libSQL) database
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-auth-token

# Session signing secret (generate: openssl rand -base64 32)
AUTH_SECRET=replace-with-random-secret
AUTH_URL=http://localhost:3000

# Ably realtime (server key root:xxxx, client key uses capability limits)
ABLY_API_KEY=your-ably-root-key
NEXT_PUBLIC_ABLY_CLIENT_KEY=your-ably-public-client-key

# App URL used for redirects and callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Teacher registration invite code (teachers must supply this to register)
TEACHER_INVITE_CODE=EDUQUEST-TEACHER-2026
